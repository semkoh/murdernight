# Copier ce fichier en .env et changer les valeurs
DB_AUTH_PASSWORD=auth_pwd
DB_METIER_PASSWORD=metier_pwd
JWT_SECRET=une-longue-phrase-secrete-a-changer
INTERNAL_KEY=une-cle-interne-a-changer

# Ports sur votre PC (changez-les s'ils sont déjà utilisés)
BFF_PORT=3001
FRONT_PORT=5173

# Pour jouer depuis les téléphones : l'adresse IP du PC sur le Wi-Fi (commande ipconfig)
PUBLIC_HOST=localhost
